{
  "name": "fitme-claude-proxy",
  "private": true,
  "type": "module",
  "description": "Holds FitMe's Anthropic key: checks App Attest, counts each device's monthly allowance, forwards Messages API calls.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@peculiar/x509": "3.1.0",
    "cborg": "4.2.11",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251014.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.42.2"
  }
}
